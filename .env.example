# Copy this file to .env and adjust the values as needed.
# Every value below has a working default in config.py, except the wallet
# keys, which docker-compose.yml needs to start the containers.

# Name of the Docker network von-network creates. start.sh discovers and
# writes this automatically, you normally don't need to set it by hand.
VON_NETWORK_NAME=von_von

# VON-network ledger registration endpoint (used to register issuer DIDs).
LEDGER_REGISTER_URL=http://localhost:9000/register

# Wallet encryption keys for the four agents (required by docker-compose).
GOVERNMENT_WALLET_KEY=government_wallet_key
EMPLOYER_WALLET_KEY=employer_wallet_key
TENANT_WALLET_KEY=tenant_wallet_key
LANDLORD_WALLET_KEY=landlord_wallet_key

# Agent seeds. Each seed must be exactly 32 characters. The Government and
# Employer seeds are registered on the ledger; Tenant and Landlord are not.
GOVERNMENT_SEED=gov_agent_seed_32_characters_01!
EMPLOYER_SEED=emp_agent_seed_32_characters_02!
TENANT_SEED=tenant_agent_seed_32_characters0
LANDLORD_SEED=landlord_agent_seed_32_chars0040

# ACA-Py Admin API URLs (only needed if you change the ports in the compose
# file; the defaults below match docker-compose.yml).
GOVERNMENT_URL=http://localhost:8032
EMPLOYER_URL=http://localhost:8022
TENANT_URL=http://localhost:8042
LANDLORD_URL=http://localhost:8052
